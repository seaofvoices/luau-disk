{
  "name": "luau-disk",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/seaofvoices/luau-disk.git"
  },
  "license": "MIT",
  "main": "./src/init.luau",
  "keywords": [
    "luau",
    "roblox",
    "lua",
    "data",
    "immutable",
    "react",
    "roact"
  ],
  "scripts": {
    "prepare": "npmluau",
    "test:roblox": "sh ./scripts/roblox-test.sh",
    "build": "sh ./scripts/build-assets.sh",
    "lint": "sh ./scripts/analyze.sh && selene src",
    "lint:luau": "sh ./scripts/analyze.sh",
    "lint:selene": "selene src",
    "format": "stylua .",
    "style-check": "stylua . --check",
    "verify-pack": "yarn pack --dry-run",
    "clean": "rm -rf node_modules roblox build"
  },
  "devDependencies": {
    "@jsdotlua/jest": "^3.10.0",
    "@jsdotlua/jest-globals": "^3.10.0",
    "npmluau": "^0.1.2"
  },
  "packageManager": "yarn@4.13.0"
}
